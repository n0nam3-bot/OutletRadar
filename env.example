# Product search provider. Create a free key at https://api.sh/ (1,000 free credits/month).
API_SH_KEY=

# Neon PostgreSQL connection string (pooled connection string recommended).
DATABASE_URL=

# Vercel Cron secret. Use a random value of at least 32 characters.
CRON_SECRET=

# Maximum watchlist items refreshed by the daily price-check job (hard-capped in code at 10).
MAX_DAILY_PRICE_CHECKS=10

# Optional: independent salt for hashed-IP daily search limits. Defaults to API_SH_KEY.
RATE_LIMIT_SALT=
