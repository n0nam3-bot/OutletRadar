# Nike public product catalog provider (existing integration).
API_SH_KEY=

# Neon PostgreSQL pooled connection string.
DATABASE_URL=

# Marketplace catalog discovery and online comparison: StockX, GOAT, Flight Club, Kicks Crew.
# PCKT Free currently advertises 500 credits/month. The app caps reservations at 450/month.
PCKT_API_KEY=

# Optional Google Shopping search for Foot Locker, Champs, JD Sports and other online merchants.
# SerpApi Free currently advertises 250 searches/month. The app caps reservations at 200/month.
SERPAPI_API_KEY=

# Existing daily price-check job.
CRON_SECRET=
MAX_DAILY_PRICE_CHECKS=10
RATE_LIMIT_SALT=

# --- Optional tuning (v2.3). Defaults are shown; leave unset to use them. ---
# Application-side safety ceilings. Keep monthly values below each provider's free allowance.
# PCKT_DAILY_BUDGET=15
# PCKT_MONTHLY_BUDGET=450
# SERPAPI_DAILY_BUDGET=7
# SERPAPI_MONTHLY_BUDGET=200
# APISH_DAILY_BUDGET=25
# APISH_MONTHLY_BUDGET=1000
# Share of each day's budget the background warm-up job may use (0.05-0.9).
# WARM_DAILY_SHARE=0.4
