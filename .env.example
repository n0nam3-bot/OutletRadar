# Nike public product catalog provider (existing integration).
API_SH_KEY=

# Neon PostgreSQL pooled connection string.
DATABASE_URL=

# Marketplace catalog discovery and online comparison: StockX, GOAT, Flight Club, Kicks Crew.
# PCKT Free currently advertises 500 credits/month. The app caps reservations at 450/month.
PCKT_API_KEY=

# Optional Google Shopping search for Foot Locker, Champs, JD Sports and other online merchants.
# SerpApi Free currently advertises 250 searches/month. The app caps reservations at 200/month.
SERPAPI_API_KEY=

# Existing daily price-check job.
CRON_SECRET=
MAX_DAILY_PRICE_CHECKS=10
RATE_LIMIT_SALT=

# --- Optional tuning (v2.3). Defaults are shown; leave unset to use them. ---
# Application-side safety ceilings. Keep monthly values below each provider's free allowance.
# PCKT_DAILY_BUDGET=15
# PCKT_MONTHLY_BUDGET=450
# SERPAPI_DAILY_BUDGET=7
# SERPAPI_MONTHLY_BUDGET=200
# APISH_DAILY_BUDGET=25
# APISH_MONTHLY_BUDGET=1000
# Share of each day's budget the background warm-up job may use (0.05-0.9).
# WARM_DAILY_SHARE=0.4

# --- Channel3: live cross-store comparison (adidas, New Balance, Puma, Reebok, Vans, Foot Locker, ...) ---
# Free account: 1,000 credits/month at https://trychannel3.com . One credit per Compare offers click, cached 3 hours.
# CHANNEL3_API_KEY=
# CHANNEL3_DAILY_BUDGET=30
# CHANNEL3_MONTHLY_BUDGET=900

# --- eBay Browse API: new fixed-price eBay listings in Compare offers ---
# Free developer account at https://developer.ebay.com . Use the PRODUCTION keyset
# (App ID = client id, Cert ID = client secret). Default allowance is 5,000 calls/day.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# Optional: eBay Partner Network campaign id, so eBay links earn commission.
# EBAY_CAMPAIGN_ID=
# EBAY_DAILY_BUDGET=3000
# EBAY_MONTHLY_BUDGET=90000

# --- Impact partner catalogs: offers from the brands/stores that approved your Impact account ---
# Impact dashboard > Account Settings > API. Items carry your affiliate tracking links.
# IMPACT_ACCOUNT_SID=
# IMPACT_AUTH_TOKEN=
# IMPACT_DAILY_BUDGET=500
# IMPACT_MONTHLY_BUDGET=15000

# --- Affiliate link templates (v2.9) ---
# JSON object: store website host -> tracking-link template from your affiliate network's deep-link
# generator, with {url} where the product link goes ({rawurl} = unencoded). Example (single line):
# AFFILIATE_LINK_TEMPLATES={"goat.com":"https://goat.sjv.io/c/1111/2222/3333?u={url}"}

# --- Bulk feed ingestion (v3.2, OFF by default) ---
# Loads Impact advertiser catalogs into the shared catalog in pages, so browse shows their offers without a
# live call per search. Needs the Impact keys, migration 006 and the catalog ids from
# /admin/providers > Preview Impact feeds.
# FEED_INGEST_ENABLED=true
# IMPACT_FEED_CATALOG_IDS=42,77
# FEED_PAGES_PER_RUN=2
# FEED_MAX_DB_MB=350
# FEED_ITEM_REGEX=\b(?:shoes?|sneakers?|trainers?|boots?)\b

# --- Scaling (v3.4) ---
# How long the CDN may serve a complete search answer without reaching the server (seconds, 0 = off). Default 600.
# CATALOG_CDN_SECONDS=600
# A search must be made at least this many times in 7 days before the daily warm-up refreshes it. Default 2.
# WARM_MIN_SEARCHES=2
